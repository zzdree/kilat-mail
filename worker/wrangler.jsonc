{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kilat-mail-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kilat_mail_db",
      "database_id": "11944c07-6d0c-4a52-a024-8b1a3d038f4b"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "*",
    "EMAIL_EXPIRY_HOURS": "48"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
